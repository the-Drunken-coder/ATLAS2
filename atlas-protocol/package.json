{
  "name": "atlas-protocol",
  "version": "0.1.0",
  "description": "Local Atlas Protocol validator and TypeScript package",
  "private": true,
  "main": "dist/packages/typescript/src/index.js",
  "types": "dist/packages/typescript/src/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/sync-examples-from-docs.cjs",
    "build": "tsc --project tsconfig.json && node scripts/copy-protocol-dist.cjs",
    "bundle": "npm run build && node dist/scripts/export-schema-bundle.js",
    "verify": "npm run build && node dist/scripts/verify.js",
    "verify:standalone": "npm run build && ATLAS_PROTOCOL_ROOT=dist/protocol node dist/scripts/verify.js",
    "validate": "npm run build && node dist/scripts/validate.js"
  },
  "keywords": [
    "atlas",
    "protocol"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "typescript": "6.0.3"
  }
}
