{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/entity.schema.json",
  "title": "Atlas entity JSON",
  "$defs": {
    "customSection": {
      "type": "object"
    },
    "supportedCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "altitude_m": { "type": "number" },
        "speed_m_s": { "type": "number" },
        "heading_deg": { "type": "number" },
        "uncertainty_radius_m": { "type": "number" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "priority": { "type": "integer" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "coordinates": { "type": "array" }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "sequence": { "type": "integer" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "battery_percent": { "type": "number" },
        "faults": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "communications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "address": { "type": "string" },
              "rssi_dbm": { "type": "number" },
              "snr_db": { "type": "number" }
            }
          }
        }
      }
    },
    "sensorRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sensor_id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "object_id": { "type": "string" },
              "mount": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "location": { "type": "string", "minLength": 1 },
                  "bearing_deg": { "type": "number" },
                  "elevation_deg": { "type": "number" },
                  "roll_deg": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "fusionSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "source_count": { "type": "integer" },
        "confidence": { "type": "number" },
        "provenance_object_id": { "type": "string" }
      }
    }
  },
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "properties": {
        "supported_commands": { "$ref": "#/$defs/supportedCommands" },
        "telemetry": { "$ref": "#/$defs/telemetry" },
        "status": { "$ref": "#/$defs/status" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "heartbeat": { "$ref": "#/$defs/heartbeat" },
        "health": { "$ref": "#/$defs/health" },
        "communications": { "$ref": "#/$defs/communications" },
        "sensor_refs": { "$ref": "#/$defs/sensorRefs" },
        "fusion_summary": { "$ref": "#/$defs/fusionSummary" }
      },
      "patternProperties": {
        "^custom_": { "$ref": "#/$defs/customSection" }
      },
      "additionalProperties": true
    },
    "extra": { "type": "object" }
  },
  "patternProperties": {
    "^custom_": { "$ref": "#/$defs/customSection" }
  },
  "additionalProperties": true
}
