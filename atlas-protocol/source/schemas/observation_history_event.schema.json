{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Protocol Observation History Event",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "telemetry",
        "identity_patch",
        "lifecycle"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "base_observation_version": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "recorded_at",
    "observation_id",
    "base_observation_version",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": { "const": "telemetry" }
        },
        "required": ["event_type"]
      },
      "then": {
        "required": ["observed_at"]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "identity_patch" }
        },
        "required": ["event_type"]
      },
      "then": {
        "required": ["effective_at"],
        "properties": {
          "observed_at": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "lifecycle" }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "observed_at": false
        }
      }
    }
  ]
}
