{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Protocol Observation JSON",
  "type": "object",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "customSection": {
      "type": "object"
    },
    "telemetryEnvelope": {
      "type": "object",
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "data": {
          "type": "object"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "observed_at",
        "kind",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "identity": {
      "type": "object"
    },
    "latest_telemetry": {
      "$ref": "#/$defs/telemetryEnvelope"
    },
    "history_object_id": {
      "type": "string"
    },
    "extra": {
      "type": "object"
    }
  },
  "patternProperties": {
    "^custom_": {
      "$ref": "#/$defs/customSection"
    }
  },
  "additionalProperties": false
}
