{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Protocol Command Catalog JSON",
  "type": "object",
  "$defs": {
    "customSection": {
      "type": "object"
    },
    "parameterDef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object", "array"]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "const": "command_catalog"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "extra": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parameters_schema": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/parameterDef"
            }
          }
        },
        "required": ["id", "name", "description", "parameters_schema"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "name", "description", "commands"],
  "patternProperties": {
    "^custom_": {
      "$ref": "#/$defs/customSection"
    }
  },
  "additionalProperties": false
}
