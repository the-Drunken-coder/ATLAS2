{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Protocol Command Catalog JSON",
  "type": "object",
  "$defs": {
    "schemaNode": {
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "const": "command_catalog"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parameters_schema": {
            "$ref": "#/$defs/schemaNode"
          }
        },
        "required": ["id", "name", "description", "parameters_schema"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "name", "description", "commands"],
  "additionalProperties": false
}
