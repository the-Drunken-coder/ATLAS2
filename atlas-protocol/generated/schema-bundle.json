{
  "protocolVersion": "0.1.0",
  "schemas": {
    "change-event": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Change Event",
      "type": "object",
      "$defs": {
        "nonEmptyString": {
          "type": "string",
          "minLength": 1
        }
      },
      "properties": {
        "type": {
          "const": "change_event"
        },
        "event_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource": {
          "type": "string",
          "enum": [
            "entity",
            "object",
            "task",
            "observation"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "created",
            "updated",
            "deleted"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "type": [
            "object",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "event_id",
        "resource",
        "operation",
        "resource_id",
        "resource_version",
        "occurred_at",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "command-catalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Command Catalog JSON",
      "type": "object",
      "$defs": {
        "parameterDef": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "boolean",
                "object",
                "array"
              ]
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "properties": {
        "type": {
          "type": "string",
          "const": "command_catalog"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "parameters_schema": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/parameterDef"
                }
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "parameters_schema"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "name",
        "description",
        "commands"
      ],
      "additionalProperties": false
    },
    "entity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Entity JSON",
      "type": "object",
      "$defs": {
        "nonEmptyString": {
          "type": "string",
          "minLength": 1
        },
        "extraObject": {
          "type": "object"
        },
        "customSection": {
          "type": "object"
        },
        "supportedCommands": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "commands"
          ],
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_m": {
              "type": "number"
            },
            "speed_m_s": {
              "type": "number",
              "minimum": 0
            },
            "heading_deg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "uncertainty_radius_m": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "trackTelemetry": {
          "allOf": [
            {
              "$ref": "#/$defs/telemetry"
            },
            {
              "required": [
                "latitude",
                "longitude"
              ]
            }
          ]
        },
        "geometry": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "coordinates": {
              "type": "array"
            },
            "geometries": {
              "type": "array"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "object",
          "properties": {
            "state": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "label": {
              "type": "string"
            },
            "priority": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "heartbeat": {
          "type": "object",
          "properties": {
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "health": {
          "type": "object",
          "properties": {
            "state": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "battery_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "faults": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "communications": {
          "type": "object",
          "properties": {
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "status": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "address": {
                    "type": "string"
                  },
                  "rssi_dbm": {
                    "type": "number"
                  },
                  "snr_db": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "sensorRefs": {
          "type": "object",
          "properties": {
            "sensors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sensor_id": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "type": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "label": {
                    "type": "string"
                  },
                  "object_id": {
                    "type": "string"
                  },
                  "mount": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "$ref": "#/$defs/nonEmptyString"
                      },
                      "bearing_deg": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 360
                      },
                      "elevation_deg": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "roll_deg": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 360
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "fusionSummary": {
          "type": "object",
          "properties": {
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_count": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "provenance_object_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "asset": {
          "type": "object",
          "properties": {
            "components": {
              "type": "object",
              "properties": {
                "supported_commands": {
                  "$ref": "#/$defs/supportedCommands"
                },
                "telemetry": {
                  "$ref": "#/$defs/telemetry"
                },
                "status": {
                  "$ref": "#/$defs/status"
                },
                "heartbeat": {
                  "$ref": "#/$defs/heartbeat"
                },
                "health": {
                  "$ref": "#/$defs/health"
                },
                "communications": {
                  "$ref": "#/$defs/communications"
                },
                "sensor_refs": {
                  "$ref": "#/$defs/sensorRefs"
                }
              },
              "required": [
                "supported_commands"
              ],
              "patternProperties": {
                "^custom_": {
                  "$ref": "#/$defs/customSection"
                }
              },
              "additionalProperties": false
            },
            "extra": {
              "$ref": "#/$defs/extraObject"
            }
          },
          "required": [
            "components"
          ],
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        },
        "track": {
          "type": "object",
          "properties": {
            "components": {
              "type": "object",
              "properties": {
                "telemetry": {
                  "$ref": "#/$defs/trackTelemetry"
                },
                "status": {
                  "$ref": "#/$defs/status"
                },
                "fusion_summary": {
                  "$ref": "#/$defs/fusionSummary"
                }
              },
              "required": [
                "telemetry"
              ],
              "patternProperties": {
                "^custom_": {
                  "$ref": "#/$defs/customSection"
                }
              },
              "additionalProperties": false
            },
            "extra": {
              "$ref": "#/$defs/extraObject"
            }
          },
          "required": [
            "components"
          ],
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        },
        "geofeature": {
          "type": "object",
          "properties": {
            "components": {
              "type": "object",
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "status": {
                  "$ref": "#/$defs/status"
                }
              },
              "required": [
                "geometry"
              ],
              "patternProperties": {
                "^custom_": {
                  "$ref": "#/$defs/customSection"
                }
              },
              "additionalProperties": false
            },
            "extra": {
              "$ref": "#/$defs/extraObject"
            }
          },
          "required": [
            "components"
          ],
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "object": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Object JSON",
      "type": "object",
      "$defs": {
        "customSection": {
          "type": "object"
        },
        "log": {
          "type": "object",
          "properties": {
            "log_type": {
              "type": "string"
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            },
            "extra": {
              "type": "object"
            }
          },
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        },
        "photo": {
          "type": "object",
          "properties": {
            "content_type": {
              "type": "string"
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            },
            "width_px": {
              "type": "integer",
              "minimum": 1
            },
            "height_px": {
              "type": "integer",
              "minimum": 1
            },
            "extra": {
              "type": "object"
            }
          },
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        },
        "document": {
          "type": "object",
          "properties": {
            "content_type": {
              "type": "string"
            },
            "extra": {
              "type": "object"
            }
          },
          "patternProperties": {
            "^custom_": {
              "$ref": "#/$defs/customSection"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "observation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Observation JSON",
      "type": "object",
      "$defs": {
        "nonEmptyString": {
          "type": "string",
          "minLength": 1
        },
        "customSection": {
          "type": "object"
        }
      },
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "ended"
          ]
        },
        "latest_sighting": {
          "type": "object",
          "properties": {
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "data": {
              "type": "object"
            },
            "extra": {
              "type": "object"
            }
          },
          "required": [
            "observed_at",
            "kind",
            "data"
          ],
          "additionalProperties": false
        },
        "sightings_object_id": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "state"
      ],
      "patternProperties": {
        "^custom_": {
          "$ref": "#/$defs/customSection"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Task JSON",
      "type": "object",
      "$defs": {
        "nonEmptyString": {
          "type": "string",
          "minLength": 1
        },
        "customSection": {
          "type": "object"
        }
      },
      "properties": {
        "description": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "components": {
          "type": "object",
          "properties": {
            "command": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "parameters": {
              "type": "object"
            },
            "progress": {
              "type": "object"
            },
            "result": {
              "type": "object"
            },
            "error": {
              "type": "object"
            }
          },
          "required": [
            "command",
            "parameters"
          ],
          "additionalProperties": false
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "components"
      ],
      "patternProperties": {
        "^custom_": {
          "$ref": "#/$defs/customSection"
        }
      },
      "additionalProperties": false
    },
    "validation-error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Atlas Protocol Validation Error JSON",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "field",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
