ATLAS_POSTGRES_HOST=localhost
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas
ATLAS_POSTGRES_DB=atlas_core
ATLAS_POSTGRES_SSLMODE=disable
ATLAS_POSTGRES_MAX_CONNS=8
ATLAS_OBJECT_STORAGE_DIR=/var/lib/atlas-datastorage/objects
ATLAS_DATASTORAGE_LISTEN_ADDR=0.0.0.0:8081
ATLAS_DATASTORAGE_ADDR=atlas-datastorage:8081
ATLAS_DATASTORAGE_INTERNAL_TOKEN=replace-with-local-secret
ATLAS_FUNCTIONS_LISTEN_ADDR=0.0.0.0:8080
ATLAS_FUNCTIONS_HOST_PORT=8080
ATLAS_LOG_LEVEL=info
ATLAS_READY_FILE=/var/lib/atlas-datastorage/.ready
ATLAS_RECONCILE_INTERVAL=1m
ATLAS_RECONCILE_TIMEOUT=30s
ATLAS_RUN_ID=local
