# Optional: path to JSON config (see atlas-core/config.example.json). When unset,
# Core also loads ./config.json from the process working directory if that file exists.
# Environment variables still override values from the file.
# ATLAS_CONFIG_FILE=/absolute/path/to/config.json
ATLAS_POSTGRES_HOST=localhost
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas
ATLAS_POSTGRES_DB=atlas_core
ATLAS_POSTGRES_SSLMODE=disable
# Max connections for the server pgx pool (integer; docker-compose default 8).
ATLAS_POSTGRES_MAX_CONNS=8
ATLAS_POSTGRES_HOST_PORT=5432
ATLAS_OBJECT_STORAGE_DIR=/var/lib/atlas-core/objects
ATLAS_LOG_LEVEL=info
# Path written when the process is ready for traffic (matches docker-compose fixed path).
ATLAS_READY_FILE=/var/lib/atlas-core/.ready
# Background reconcile cadence (Go duration, e.g. 1m; compose default 1m).
ATLAS_RECONCILE_INTERVAL=1m
# Per-reconcile deadline (Go duration, e.g. 30s; compose default 30s).
ATLAS_RECONCILE_TIMEOUT=30s
ATLAS_RUN_ID=local
