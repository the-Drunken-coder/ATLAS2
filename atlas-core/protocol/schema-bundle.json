{
  "name": "atlas-protocol",
  "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "schemas": [
    {
      "name": "change-event",
      "path": "schemas/change-event.schema.json",
      "sha256": "976d20448feeed262603e0eca9a3dfafa8f860489fb56cf7f9d1b4d9f2713129",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/change-event.schema.json",
        "title": "Atlas change event",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_kind",
          "operation",
          "resource_id",
          "occurred_at"
        ],
        "properties": {
          "resource_kind": {
            "type": "string",
            "enum": [
              "entity",
              "object",
              "task",
              "observation"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "manifest_sync"
            ]
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "command-catalog",
      "path": "schemas/command-catalog.schema.json",
      "sha256": "9f7528a874b9ef03817395b86d9ad55ab8fa7263115397dea5563638a2d0d09c",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/command-catalog.schema.json",
        "title": "Atlas command catalog payload",
        "$defs": {
          "parameterSchema": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/parameterSchema"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "items": {
                "$ref": "#/$defs/parameterSchema"
              },
              "enum": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "object",
                    "array",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commands"
        ],
        "properties": {
          "commands": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "parameters_schema"
              ],
              "additionalProperties": true,
              "properties": {
                "description": {
                  "type": "string"
                },
                "parameters_schema": {
                  "$ref": "#/$defs/parameterSchema"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "entity",
      "path": "schemas/entity.schema.json",
      "sha256": "362a8dc9b4c8ecb38c446aa2f8449a76d6c8930c3fd3ce2c585f61694b7639c2",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/entity.schema.json",
        "title": "Atlas entity JSON",
        "$defs": {
          "customSection": {
            "type": "object"
          },
          "supportedCommands": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commands"
            ],
            "properties": {
              "commands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "altitude_m": {
                "type": "number"
              },
              "speed_m_s": {
                "type": "number"
              },
              "heading_deg": {
                "type": "number"
              },
              "uncertainty_radius_m": {
                "type": "number"
              }
            }
          },
          "status": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "priority": {
                "type": "integer"
              }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "heartbeat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "source": {
                "type": "string"
              },
              "sequence": {
                "type": "integer"
              }
            }
          },
          "health": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1
              },
              "battery_percent": {
                "type": "number"
              },
              "faults": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "communications": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "address": {
                      "type": "string"
                    },
                    "rssi_dbm": {
                      "type": "number"
                    },
                    "snr_db": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "sensorRefs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sensors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sensor_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    },
                    "object_id": {
                      "type": "string"
                    },
                    "mount": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "location": {
                          "type": "string",
                          "minLength": 1
                        },
                        "bearing_deg": {
                          "type": "number"
                        },
                        "elevation_deg": {
                          "type": "number"
                        },
                        "roll_deg": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "fusionSummary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_count": {
                "type": "integer"
              },
              "confidence": {
                "type": "number"
              },
              "provenance_object_id": {
                "type": "string"
              }
            }
          }
        },
        "type": "object",
        "properties": {
          "components": {
            "type": "object",
            "properties": {
              "supported_commands": {
                "$ref": "#/$defs/supportedCommands"
              },
              "telemetry": {
                "$ref": "#/$defs/telemetry"
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "geometry": {
                "$ref": "#/$defs/geometry"
              },
              "heartbeat": {
                "$ref": "#/$defs/heartbeat"
              },
              "health": {
                "$ref": "#/$defs/health"
              },
              "communications": {
                "$ref": "#/$defs/communications"
              },
              "sensor_refs": {
                "$ref": "#/$defs/sensorRefs"
              },
              "fusion_summary": {
                "$ref": "#/$defs/fusionSummary"
              }
            },
            "patternProperties": {
              "^custom_": {
                "$ref": "#/$defs/customSection"
              }
            },
            "additionalProperties": true
          },
          "extra": {
            "type": "object"
          }
        },
        "patternProperties": {
          "^custom_": {
            "$ref": "#/$defs/customSection"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "name": "object",
      "path": "schemas/object.schema.json",
      "sha256": "40dd4eb079a337b66c833852df594cdec1e3db6a95d07b19b83973f140728ca0",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/object.schema.json",
        "title": "Atlas object JSON",
        "$defs": {
          "parameterSchema": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/parameterSchema"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "items": {
                "$ref": "#/$defs/parameterSchema"
              },
              "enum": {
                "type": "array"
              }
            }
          },
          "customSection": {
            "type": "object"
          }
        },
        "type": "object",
        "properties": {
          "log_type": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_type": {
            "type": "string"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "width_px": {
            "type": "integer"
          },
          "height_px": {
            "type": "integer"
          },
          "commands": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "parameters_schema"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "parameters_schema": {
                  "$ref": "#/$defs/parameterSchema"
                }
              },
              "additionalProperties": true
            }
          },
          "extra": {
            "type": "object"
          },
          "manifest": {},
          "manifest_version": {}
        },
        "patternProperties": {
          "^custom_": {
            "$ref": "#/$defs/customSection"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "name": "observation",
      "path": "schemas/observation.schema.json",
      "sha256": "77aa48a241741fdc9f012c0128e7bfcbb5d753fc9b0f01246496b995725588f4",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/observation.schema.json",
        "title": "Atlas observation JSON",
        "$defs": {
          "customSection": {
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "ended"
            ]
          },
          "latest_sighting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "kind",
              "data"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object"
              },
              "extra": {
                "type": "object"
              }
            }
          },
          "sightings_object_id": {
            "type": "string"
          },
          "extra": {
            "type": "object"
          }
        },
        "patternProperties": {
          "^custom_": {
            "$ref": "#/$defs/customSection"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "task",
      "path": "schemas/task.schema.json",
      "sha256": "15892b3cda9f1b25279009b10e5d75e128a4a97c4b72cb1c672821d23be9e56a",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/task.schema.json",
        "title": "Atlas task JSON",
        "$defs": {
          "customSection": {
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "components"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          },
          "extra": {
            "type": "object"
          },
          "components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "parameters"
            ],
            "properties": {
              "command": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "parameters": {
                "type": "object"
              },
              "progress": {
                "type": "object"
              },
              "result": {
                "type": "object"
              },
              "error": {
                "type": "object"
              }
            }
          }
        },
        "patternProperties": {
          "^custom_": {
            "$ref": "#/$defs/customSection"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "validation-error",
      "path": "schemas/validation-error.schema.json",
      "sha256": "84f53b868a00a3809fc783e89f5f1df6e3557f5989627dcc0f7b6a95f832d3ea",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://atlas.local/schemas/validation-error.schema.json",
        "title": "Atlas validation error",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
